# Copy to .env (or set in your container environment)

# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite by default; point at PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://funquote:funquote@db:5432/funquote
DATABASE_URL=sqlite:///./data/funquote.db

# AI provider: "openai" or "mock". With "mock" (or no API key) the app is
# fully usable manually; AI-assist uses a deterministic offline parser.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where uploaded logos are stored
UPLOAD_DIR=./data/uploads
