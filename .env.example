# Copy to .env (or set in your container environment)

# Secret used to sign session cookies AND to encrypt tenants' stored AI API
# keys. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later invalidates sessions and makes stored AI keys unreadable
# (tenants would re-enter them).
SECRET_KEY=change-me

# SQLite by default; point at PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://funquote:funquote@db:5432/funquote
DATABASE_URL=sqlite:///./data/funquote.db

# Server-wide AI FALLBACK, used only for organizations that have not
# connected their own provider under Settings → AI provider (each tenant is
# expected to bring their own OpenAI/Anthropic/Google account or local
# server — an org's own configuration always wins over this).
#   none   – no fallback: every org must connect its own provider (recommended
#            for multi-tenant production)
#   mock   – deterministic offline parser (dev/tests)
#   openai – shared OpenAI key below (convenient for a single-tenant install)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where uploaded logos are stored
UPLOAD_DIR=./data/uploads

# Outbound email — used for user invitations and password-reset links.
# Leave SMTP_HOST empty to run without email: invite links are then shown in
# the UI for admins to copy, and reset links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=quotes@example.com
# starttls (default, port 587) / ssl (port 465) / none (local relay)
SMTP_SECURITY=starttls

# Public URL of this app, used in emailed links (falls back to the request's
# own host if empty), e.g. https://quotes.example.com
APP_BASE_URL=
